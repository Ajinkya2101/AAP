# Client replica (aap.clientdata.replica): its own databases next to the synthetic ebs / aap.
# Copy to .env.kk (git-ignored). Load: uv run python -m aap.clientdata.replica --local --create-databases --from <delivery>
# To run the stack on the replica, use these values instead of .env's (same keys).
AAP_DSN=postgresql://aap_app:aap_app@postgres:5432/aap_kk
AAP_OWNER_DSN=postgresql://aap_owner:aap_owner@postgres:5432/aap_kk
EBS_OWNER_DSN=postgresql://ebs_owner:ebs_owner@postgres:5432/ebs_kk
EBS_RO_DSN=postgresql://apps_ro:apps_ro@postgres:5432/ebs_kk
EBS_INTF_DSN=postgresql://apps_intf:apps_intf@postgres:5432/ebs_kk
POSTGRES_PASSWORD=postgres

# Krispy Kreme chart of accounts: 8 segments joined by "." (company 1, store / cost center 3 and
# natural account 4 are assumptions until Vikram confirms the segment meanings, B-2)
GL_SEGMENT_COUNT=8
GL_SEGMENT_SEPARATOR=.
GL_COMPANY_SEGMENT=1
GL_COST_CENTER_SEGMENT=3
GL_NATURAL_ACCOUNT_SEGMENT=4
TERMS_DATE_BASIS=Invoice
# AP keeps the supplier site's terms (python -m aap.clientdata.history); printed terms are only noted
TERMS_SOURCE=site_default
# INSTANCE_MAP_FILE=client-data/kk/instance-map.csv   (only if the internal instance's values differ, B-0)
