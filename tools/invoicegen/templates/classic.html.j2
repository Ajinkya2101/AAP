{% extends "base.html.j2" %}
{% from "macros.html.j2" import vendor_block, party_block, meta_rows, lines_table, totals_table, payment_block %}
{% block style %}
  h1 { font-size: 20pt; margin: 0; text-align: right; }
  .lines th { border-bottom: 1.5px solid #000; text-align: left; }
  .lines td { border-bottom: 0.5px solid #ccc; }
  .totals { width: 45%; margin-left: 55%; margin-top: 8px; }
  .grand td { border-top: 1.5px solid #000; }
{% endblock %}
{% block body %}
<table><tr>
  <td style="width:55%">{{ vendor_block(inv.vendor, labels) }}</td>
  <td><h1>{{ labels.title }}</h1><table>{{ meta_rows(inv, labels) }}</table></td>
</tr></table>
<br>
<table><tr>
  <td style="width:50%">{{ party_block(labels.bill_to, inv.bill_to) }}</td>
  <td>{% if inv.ship_to %}{{ party_block(labels.ship_to, inv.ship_to) }}{% endif %}</td>
</tr></table>
<br>
{{ lines_table(inv, labels) }}
{{ totals_table(inv, labels) }}
<br>{{ payment_block(inv, labels) }}
{% if inv.notes %}<p class="small muted">{{ inv.notes }}</p>{% endif %}
{% endblock %}
