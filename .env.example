# AAP Module - environment (docs/IMPLEMENTATION-PLAN.md section 14)
# Copied to .env by start_container.bat on first start. Dev values only.

# ---- runtime switches
ADAPTER=ebs_mock
# vllm | stub  (start_container.bat overrides this from the detected mode)
LLM_BACKEND=stub
DEV_RELOAD=0
LOG_LEVEL=INFO

# ---- PostgreSQL (one container, databases: aap, ebs)
POSTGRES_PASSWORD=postgres
PG_HOST=postgres
PG_PORT=5432
AAP_DSN=postgresql://aap_app:aap_app@postgres:5432/aap
AAP_OWNER_DSN=postgresql://aap_owner:aap_owner@postgres:5432/aap
EBS_OWNER_DSN=postgresql://ebs_owner:ebs_owner@postgres:5432/ebs
EBS_RO_DSN=postgresql://apps_ro:apps_ro@postgres:5432/ebs
EBS_INTF_DSN=postgresql://apps_intf:apps_intf@postgres:5432/ebs

# ---- mock EBS seed
SEED=42
SEED_SCALE=default
# business "today" of the mock data: the anchor month and the one before are open AP periods
SEED_ANCHOR_DATE=2026-09-28
# APXIIMPT simulated run time (seconds)
EBS_IMPORT_DELAY_MIN=1
EBS_IMPORT_DELAY_MAX=10

# ---- LLM: connection (vLLM, OpenAI-compatible)
VLLM_IMAGE=vllm/vllm-openai:v0.10.1.1
VLLM_BASE_URL=http://vllm:8000/v1
# Host port for debugging only (8000 is often taken); containers use vllm:8000.
VLLM_HOST_PORT=8100
VLLM_API_KEY=local
LLM_TIMEOUT_SECONDS=180
HF_TOKEN=

# ---- LLM: which models
# EXTRACT_MODEL / CHOICE_MODEL are the names the application asks vLLM for.
# *_REPO is the Hugging Face repo downloaded on first start; *_DIR is its folder under /models
# (the last part of the repo name). Change the three together.
EXTRACT_MODEL=qwen2.5-vl-7b
EXTRACT_MODEL_REPO=Qwen/Qwen2.5-VL-7B-Instruct
EXTRACT_MODEL_DIR=Qwen2.5-VL-7B-Instruct
# The choice model is the extraction model unless the second server (profile gpu2) is used;
# then set CHOICE_MODEL=qwen3-8b.
CHOICE_MODEL=qwen2.5-vl-7b
CHOICE_MODEL_REPO=Qwen/Qwen3-8B
CHOICE_MODEL_DIR=Qwen3-8B

# ---- LLM: generation (read by api and worker; restart them to apply)
# 0 = the same answer for the same document. Raise only for experiments.
LLM_TEMPERATURE=0
# Output limit of one extraction request. An answer cut off at the limit fails the document.
EXTRACT_MAX_TOKENS=4096
# Output limit of one choice request (mapping, line pairing, GL coding).
CHOICE_MAX_TOKENS=300
# Page images per extraction request; longer invoices are split into several requests.
# vLLM is started with the same limit.
LLM_MAX_IMAGES_PER_REQUEST=4
# Characters of a page's text layer sent with the page; the rest is dropped.
EXTRACT_MAX_TEXT_CHARS_PER_PAGE=12000
# Resolution of the PDF page images given to the model.
PAGE_RENDER_DPI=200

# ---- LLM: vLLM server, extraction model (profile gpu; recreate the vllm container to apply)
VLLM_QUANTIZATION=fp8
# Share of the GPU memory vLLM may take.
VLLM_GPU_MEMORY_UTILIZATION=0.85
# Context window in tokens (prompt + images + answer).
VLLM_MAX_MODEL_LEN=16384
# Largest image after vLLM's own resize, in pixels (1003520 = 1280 x 28 x 28).
VLLM_MAX_PIXELS=1003520

# ---- LLM: vLLM server, text model for choices (profile gpu2, optional)
VLLM_TEXT_HOST_PORT=8101
VLLM_TEXT_QUANTIZATION=fp8
VLLM_TEXT_GPU_MEMORY_UTILIZATION=0.33
VLLM_TEXT_MAX_MODEL_LEN=8192

# ---- embeddings (bge-m3 on the CPU, for GL-history similarity)
EMBED_MODEL=BAAI/bge-m3
EMBED_MODEL_DIR=/models/bge-m3
# false: GL similarity uses text matching only.
EMBED_ENABLED=true
EMBED_THREADS=8
EMBED_MAX_TOKENS=128

# ---- files
FILESTORE_DIR=/data/filestore
TRUTH_DIR=/data/filestore/truth
MAX_UPLOAD_MB=25
# Testing: re-uploading a file already uploaded runs it through the pipeline again. Keep false in prod.
ALLOW_DUPLICATE_UPLOADS=false

# ---- agents
# PO line pairing: accepted without the model at this score, when it leads the next line by the margin.
MATCH_AUTO_ACCEPT=0.80
MATCH_MARGIN=0.15
# GL coding: similarity to a past line at which its account is taken without review.
GL_SIM_AUTO=0.90
# GL coding from identical past lines: share that must agree, and how many lines are needed.
GL_EXACT_AUTO=0.90
GL_EXACT_MIN=3

# ---- pipeline
# Invoice source code written to AP_INVOICES_INTERFACE.SOURCE
INVOICE_SOURCE=AAP
TEXT_QUALITY_THRESHOLD=0.60
